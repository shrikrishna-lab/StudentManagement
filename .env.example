# ================================================================
# EduTrack ERP — Environment Variables (Vercel + Local)
# Copy this file to server/.env for local development
# Set these as Vercel Environment Variables for production
# ================================================================

# Server
PORT=5000
VERCEL=1

# MySQL / Cloud Database (use Railway, PlanetScale, Aiven, or TiDB Cloud)
DB_HOST=your-mysql-host.railway.app
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=student_management
DB_SSL=true

# Frontend (auto-resolved on Vercel monorepo, only needed for standalone backend)
# VITE_API_URL=/api
# VITE_WS_URL=wss://your-project.vercel.app
